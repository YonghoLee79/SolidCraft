[
  {"note": "Drawing from where two lines cross (also both their midpoints) snaps to the crossing, not Mid, and holds the new line's start on both lines."},
  {"call": "engine.execute", "params": {"command": "sketch.create", "params": {"plane": "XY"}}},
  {"call": "engine.execute", "params": {"command": "sketch.options", "params": {"snap_crossings": true}}},
  {"call": "engine.execute", "params": {"command": "sketch.line", "params": {"points": [[0, 0], [40, 40]]}}},
  {"call": "engine.execute", "params": {"command": "sketch.line", "params": {"points": [[0, 40], [40, 0]]}}},
  {"start": "sketch.line"},
  {"click": {"sketch": [20.4, 19.7]}},
  {"click": {"sketch": [50, 10]}},
  {"key": "Escape"},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["curves", 2, "start_at", 0], "value": 20}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["curves", 2, "start_at", 1], "value": 20}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 1, "type"], "value": "point_on_curve"}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 2, "type"], "value": "point_on_curve"}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 3], "value": null}}},
  {"note": "Fix the first line and the second line's start, then drag its end: the held start follows the new crossing (80/3, 80/3)."},
