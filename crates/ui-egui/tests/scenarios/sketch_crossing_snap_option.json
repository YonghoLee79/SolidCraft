[
  {"note": "Snapping to where two curves cross starts off: the Sketch Palette's Crossings row turns it on, and it only works while Snap is on too. Lines (0,0)-(50,50) and (0,30)-(60,0) cross at (20, 20), away from either midpoint."},
  {"start": "sketch.create"},
  {"click": {"plane": "XY"}},
  {"call": "engine.execute", "params": {"command": "sketch.line", "params": {"points": [[0, 0], [50, 50]]}}},
  {"call": "engine.execute", "params": {"command": "sketch.line", "params": {"points": [[0, 30], [60, 0]]}}},
  {"call": "ui.view", "params": {"view": "top"}},
  {"expect": {"shown": "Crossings"}},
  {"expect": {"query": {"command": "sketch.options", "path": ["options", "snap_crossings"], "value": false}}},

  {"note": "Off: a line started at the crossing is held on one line at most, not on both."},
  {"start": "sketch.line"},
  {"click": {"sketch": [20.4, 19.7]}},
  {"click": {"sketch": [50, 35]}},
  {"key": "Escape"},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["curves", 2, "type"], "value": "line"}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 2], "value": null}}},
  {"call": "engine.execute", "params": {"command": "edit.undo", "params": {}}},

  {"note": "On from the palette: the same clicks start the line at the crossing, held on both lines."},
  {"widget": "Crossings"},
  {"expect": {"query": {"command": "sketch.options", "path": ["options", "snap_crossings"], "value": true}}},
  {"start": "sketch.line"},
  {"click": {"sketch": [20.4, 19.7]}},
  {"click": {"sketch": [50, 35]}},
  {"key": "Escape"},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["curves", 2, "start_at"], "value": [20.0, 20.0]}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 1, "type"], "value": "point_on_curve"}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 2, "type"], "value": "point_on_curve"}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 3], "value": null}}},
  {"call": "engine.execute", "params": {"command": "edit.undo", "params": {}}},

  {"note": "Snap off turns the crossing off with it; Crossings stays ticked for when Snap comes back."},
  {"widget": "Snap"},
  {"expect": {"query": {"command": "sketch.options", "path": ["options", "snap"], "value": false}}},
  {"start": "sketch.line"},
  {"click": {"sketch": [20.4, 19.7]}},
  {"click": {"sketch": [50, 35]}},
  {"key": "Escape"},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["curves", 2, "type"], "value": "line"}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["constraints", 2], "value": null}}},
  {"expect": {"query": {"command": "sketch.options", "path": ["options", "snap_crossings"], "value": true}}}
]
