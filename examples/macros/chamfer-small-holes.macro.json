{
  "macro": {
    "name": "Chamfer small holes",
    "description": "Find every cylindrical hole up to a diameter, including extrude cuts, and chamfer both ends of each one."
  },
  "params": [
    { "name": "max_dia", "label": "Chamfer holes up to", "default": "8 mm" },
    { "name": "chamfer", "label": "Chamfer distance", "default": "1 mm" }
  ],
  "commands": [
    { "command": "inspect.find_holes", "params": { "max_diameter": "{{max_dia}}" }, "let": "holes" },
    { "command": "solid.chamfer", "params": { "edges": "{{holes.edges}}", "distance": "{{chamfer}}" } }
  ]
}
