{
  "macro": {
    "name": "Chamfer large holes",
    "description": "Find every cylindrical hole wider than a diameter, including extrude cuts, and chamfer both ends of each one."
  },
  "params": [
    { "name": "min_dia", "label": "Chamfer holes larger than", "default": "5 mm" },
    { "name": "chamfer", "label": "Chamfer distance", "default": "1 mm" }
  ],
  "commands": [
    { "command": "inspect.find_holes", "params": { "min_diameter": "{{min_dia}}" }, "let": "holes" },
    { "command": "solid.chamfer", "params": { "edges": "{{holes.edges}}", "distance": "{{chamfer}}" } }
  ]
}
